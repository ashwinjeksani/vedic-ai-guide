# Copy this file to .env and configure whichever provider(s) you want.
# NEVER commit the real .env — it's gitignored on purpose.
#
# The guide's chat defaults to Anthropic. To point it at a different provider
# for every request, set CHAT_PROVIDER below (server-side; not client-facing).
# CHAT_PROVIDER=anthropic   # anthropic | openai | custom

# Anthropic — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Any OpenAI-compatible endpoint — LM Studio, Ollama, vLLM, etc. Point this at
# your own inference server to run the guide on a self-hosted / local model.
# CUSTOM_AI_URL can be just the host (e.g. http://127.0.0.1:1234 for LM
# Studio's local server, or a tunneled/reverse-proxied domain) — /v1 is
# appended automatically if you don't include a path.
# CUSTOM_AI_URL=http://127.0.0.1:1234
# Most local servers need no key; set one only if yours requires it.
# CUSTOM_AI_KEY=
# Optional — if unset, the server asks the endpoint's /v1/models for the
# first chat-capable model and uses that.
# CUSTOM_AI_MODEL=
# Optional — display name shown in the model picker. Defaults to
# "Custom Model (Free)" if unset.
# CUSTOM_AI_LABEL=Qwen3.8-27B (Free)
